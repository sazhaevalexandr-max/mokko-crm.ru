<script type="text/javascript" src="<?= BASE_PATH ?>/js/bootstrap-4.6.2.bundle.min.js"></script>
<script type="text/javascript" src="<?= BASE_PATH ?>/js/theme.js"></script>
<script>
    $(document).ready(function(){
                      $('.loader').hide();

                      
                      $('input#Email, input#Password, input#Name').unbind().blur( function(){
                                                                                 var id = $(this).attr('id');
                                                                                 var val = $(this).val();
                                                                                 
                                                                                 switch(id){
                                                                                 case 'Name':
                                                                                 var str_name = /^[a-zA-Zа-яА-Я]+$/;
                                                                                 if(val.length > 2 && val != '' && str_name.test(val)){
                                                                                 $(this).parent().removeClass('has-error has-feedback');
                                                                                 $(this).parent().addClass('has-success has-feedback');
                                                                                 $(this).parent().find('.glyphicon-remove').removeClass('glyphicon-remove');
                                                                                 $(this).parent().find('span.glyphicon').addClass('glyphicon-ok');
                                                                                 }else{
                                                                                 $(this).parent().removeClass('has-success has-feedback');
                                                                                 $(this).parent().addClass('has-error has-feedback');
                                                                                 $(this).parent().find('.glyphicon-ok').removeClass('glyphicon-ok');
                                                                                 $(this).parent().find('span.glyphicon').addClass('glyphicon-remove');
                                                                                 }
                                                                                 break;
                                                                                 
                                                                                 case 'Password':
                                                                                 var str_pass = /^[a-zA-Zа-яА-Я0-9_-]+$/;
                                                                                 if(val.length >= 8 && val.length <= 72 && val != '' && str_pass.test(val)){
                                                                                 $(this).parent().removeClass('has-error has-feedback');
                                                                                 $(this).parent().addClass('has-success has-feedback');
                                                                                 $(this).parent().find('.glyphicon-remove').removeClass('glyphicon-remove');
                                                                                 $(this).parent().find('span.glyphicon').addClass('glyphicon-ok');
                                                                                 }else{
                                                                                 $(this).parent().removeClass('has-success has-feedback');
                                                                                 $(this).parent().addClass('has-error has-feedback');
                                                                                 $(this).parent().find('.glyphicon-ok').removeClass('glyphicon-ok');
                                                                                 $(this).parent().find('span.glyphicon').addClass('glyphicon-remove');
                                                                                 }
                                                                                 
                                                                                 
                                                                                 break;
                                                                                
                                                                                 
                                                                                 case 'Email':
                                                                                 
                                                                                 if(val != '' ){
                                                                                 var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
                                                                                 $('.loader').show();
                                                                                 setTimeout(function(){
                                                                                 $('.loader').hide();
                                                                                 if(emailRegex.test(val)){
                                                                                 $('input#Email').parent().removeClass('has-error has-feedback');
                                                                                 $('input#Email').parent().addClass('has-success has-feedback');
                                                                                 $('input#Email').parent().find('.glyphicon-remove').removeClass('glyphicon-remove');
                                                                                 $('input#Email').parent().find('span.glyphicon').addClass('glyphicon-ok');
                                                                                 }else{
                                                                                 $('input#Email').parent().removeClass('has-success has-feedback');
                                                                                 $('input#Email').parent().addClass('has-error has-feedback');
                                                                                 $('input#Email').parent().find('.glyphicon-ok').removeClass('glyphicon-ok');
                                                                                 $('input#Email').parent().find('span.glyphicon').addClass('glyphicon-remove');
                                                                                 }
                                                                                 }, 300);
                                                                                 }else{
                                                                                 $(this).parent().removeClass('has-success has-feedback');
                                                                                 $(this).parent().addClass('has-error has-feedback');
                                                                                 $(this).parent().find('.glyphicon-ok').removeClass('glyphicon-ok');
                                                                                 $(this).parent().find('span.glyphicon').addClass('glyphicon-remove');
                                                                                 }
                                                                                 break;
                                                                                 
                                                                                 }
                                                                                 });
                      
                      
                       $("form#registraion").submit(function( event ) {
                                                    
                                   var password = $('input#Password');
                                   var mail = $('input#Email');
                                   var name = $('input#Name');
                                             
                                if(password.parent().hasClass('has-success') && mail.parent().hasClass('has-success') && name.parent().hasClass('has-success')){
                      ///if all success
                                submiter(mail.val(),password.val(),name.val());

                                }else{
                                ///if not all success
                                if(password.val()!==''  && mail.val()!=='' && name.val()!==''){
                                                    
                                 if($('input#Email, input#Password, input#Name').parent().hasClass('has-error')){
                                //nothing...
                                 }else{
                                                    
                                 $(".form-group:not(.has-success)").find('input').blur();
                                if(password.parent().hasClass('has-success') && mail.parent().hasClass('has-success') && name.parent().hasClass('has-success')){
                                submiter(mail.val(),password.val(),name.val());
                                }


                                }
                                }
                                                    
                                }
                                            
                                   return false;
                      });
                      
                      function submiter(login,pass,name){
                      
                     
///
                      var reg = new Object();
                      
                      reg.login = login;
                      reg.password = pass;
                      reg.name = name;
            
                      var filter = new Array();
                      filter[0] = "login";
                      filter[1] = "password";
                      filter[2] = "name";
                      
                      var data_json = JSON.stringify(reg, filter);
                      
                      $.ajax({
                             type: 'POST',
                             url: BASE_URL + '/api/auth.php?action=register',
                             contentType: 'application/json',
                             data: data_json,
                             dataType: 'json',
                             complete: function(){
								$('button').prop( "disabled", true );
                             },
                        }).done(function( data ) {
                            if (data.error) {
                                $('button').prop("disabled", false);
                                alert('Ошибка регистрации: ' + data.error);
                            } else {
                                document.write('<br/><br/><center><h3>Регистрация прошла успешно, можете <a href="<?= BASE_URL ?>/login">авторизоваться</a></h3></center>');
                            }
                        });
                      
                     // document.write(data_json);
                      
                      
///
                       return false;
                      }
                      
                      });
    </script>


</body>
</html>