
// ── Local API shim ────────────────────────────────────────────────────────────
if (typeof BASE_URL === 'undefined') { var BASE_URL = ''; }

$.ajaxPrefilter(function(options) {
    var url = options.url || '';
    if (url.indexOf('mokkoapi.azurewebsites.net') < 0) return;
    var path = url.replace(/^https?:\/\/mokkoapi\.azurewebsites\.net\//, '');
    var jsonStart = path.indexOf('{');
    var pathPart  = jsonStart >= 0 ? path.substring(0, jsonStart) : path;
    var jsonPart  = jsonStart >= 0 ? path.substring(jsonStart)    : '{}';
    pathPart = pathPart.replace(/\/$/, '');
    var parts  = pathPart.split('/').filter(function(x){ return x; });
    var module = parts[0] || '';
    var action = parts[1] || 'get';
    var params;
    try { params = JSON.parse(decodeURIComponent(jsonPart)); } catch(e) { params = {}; }
    options.type        = 'POST';
    options.url         = BASE_URL + '/api/crm.php?module=' + encodeURIComponent(module) + '&action=' + encodeURIComponent(action);
    options.contentType = 'application/json';
    options.data        = JSON.stringify(params);
    options.dataType    = 'json';
});
// ── End shim ──────────────────────────────────────────────────────────────────

function timeOn() {
    if ($.cookie('time_s') !== undefined ){
        var sec = $.cookie('time_s');
        var min = $.cookie('time_m');
        var hour = $.cookie('time_h');
    }else{
        var sec = 0;
        var min = 0;
        var hour = 0;
    }
    
    
    var body = document.getElementsByClassName("time_online")[0];
    //var cont = document.createElement('div');
    var elem = document.createElement('b');
    elem.innerHTML = hour + ":0" + min + ":0" + sec;
    //cont.appendChild(elem);
    //body.appendChild(cont);
    body.appendChild(elem);
    var a = setInterval ( function() {
                         sec++;
                         
                         if ( sec==60 ) {
                         sec = 0;
                         min++;
                         
                         } else if (min==60) {
                         min = 0;
                         hour++;
                         }
                         
                         if ( sec < 10 )  {
                         brS = ":0";
                         } else { brS = ":"} ;
                         
                         if ( min < 10 )  {
                         brM = ":0";
                         } else { brM = ":"} ;
                         
                         if (hour == 24) {
                         min = 0;
                         sec = 0;
                         
                         clearInterval(a);
                         }
                         
                         elem.innerHTML = hour + brM + min + brS + sec;
                         $.cookie('time_h', hour);
                         $.cookie('time_m', min);
                         $.cookie('time_s', sec);
                         },1000 );
    
}

timeOn();

 $.cookie('checkswitch', 'off');
 $.cookie('checkssize', '80');

function clock() {
    var d = new Date();
    var month_num = d.getMonth()
    var day = d.getDate();
    var hours = d.getHours();
    var minutes = d.getMinutes();
    var seconds = d.getSeconds();
    month=new Array("января", "февраля", "марта", "апреля", "мая", "июня",
                    "июля", "августа", "сентября", "октября", "ноября", "декабря");
    
    
    if (day <= 9) day = "0" + day;
    if (hours <= 9) hours = "0" + hours;
    if (minutes <= 9) minutes = "0" + minutes;
    if (seconds <= 9) seconds = "0" + seconds;
    
    date_time = "<h4>" + day + " " + month[month_num] +
    "<br/><small>"+ hours + ":" + minutes + ":" + seconds;
    if (document.layers) {
        document.layers.doc_time.document.write(date_time);
        document.layers.doc_time.document.close();
    }
    else document.getElementById("doc_time").innerHTML = date_time;
    setTimeout("clock()", 1000);
}
