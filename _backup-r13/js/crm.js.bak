if(typeof($.cookie('last_num')) !== undefined ){
    $.cookie('last_num', '0');
    console.log($.cookie('last_num'));
}

function get_number(){
    var lastnum = Number($.cookie('last_num'))+1
    if(lastnum > Number($.cookie('max_num'))){
    lastnum = 1;
    }

    $.cookie('last_num', lastnum);
    
    return lastnum;
}

