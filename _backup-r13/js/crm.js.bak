                                                });
  
                  function toaster(msg){
                  if(msg == "invalid token"){
                  window.location.href = BASE_URL + "/?do=exit";

                  }else if(typeof(msg) == 'undefined'){
                  $.alert({
                          title: 'Ошибка!',
                          content: "Не удлось получить ответ от сервера",
                          autoClose: 'cancel|1000',
                          theme: 'black',
                          confirmButton: 'Закрыть'
                          
                          
                          });
                  }else{
                  $.alert({
                          title: 'Ошибка!',
                          content: msg,
                          autoClose: 'cancel|1000',
                          theme: 'black',
                          confirmButton: 'Закрыть'
                          });
                  }
                  return false;
                  }
                  
                  });