                                if(guest.price == null){
                                guest.price = 0;
                                }
                                
                                $("#guests .guests_grid").append("<div guest='"+guest.id+"' class='guest_list'>"+guest.name+" <span class='pull-right'>"+guest.price+" <b class='rub'>р</b></span></div>");
                                });
                         }
                         });
                  
                  
