                  function makeid()
                  {
                  var text = "";
                  var possible = "ABCDEFGHJKLMNOPQRSTUVWXYZ";
                  
                  for( var i=0; i < 1; i++ )
                  text += possible.charAt(Math.floor(Math.random() * possible.length));
                  
                  return text;
                  }
                  
                  
